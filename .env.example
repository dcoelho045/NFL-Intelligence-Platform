# Copy to .env and fill in. Never commit .env.
#
# Only the two API keys matter. Every NFL_* setting below is optional and shows
# the default the code already uses, so an .env containing nothing but the keys
# behaves identically to one containing all of them. Uncomment a line only to
# change it.

# --- Data foundation -------------------------------------------------------
# NFL_CACHE_DIR=data/cache
# NFL_SNAPSHOT_DIR=data/snapshots
# NFL_CACHE_MODE=filesystem            # filesystem | memory | off
# NFL_CACHE_DURATION_SECONDS=86400
# NFL_REQUEST_TIMEOUT_SECONDS=60
# NFL_DEFAULT_SEASON=                  # blank = current season
# NFL_LOG_LEVEL=INFO
# NFL_LOG_JSON=false

# --- LLM (Milestone 3) -----------------------------------------------------
# Required for the assistant and for building the knowledge index.
# NFL_LLM_API_KEY and OPENAI_API_KEY are both accepted; use either one.
NFL_LLM_API_KEY=sk-your-key-here
# NFL_LLM_PROVIDER=openai
# NFL_LLM_MODEL=gpt-4.1
# NFL_LLM_TEMPERATURE=0.0              # blank = omit entirely (o4-mini, gpt-5-mini)
# NFL_LLM_MAX_ITERATIONS=5
# NFL_LLM_MAX_TOOL_CALLS=12
# NFL_LLM_TIMEOUT_SECONDS=60

# --- Web retrieval (Milestone 4) -------------------------------------------
# Either NFL_WEB_SEARCH_API_KEY, TAVILY_API_KEY or BRAVE_API_KEY is accepted.
# Leave unset to run with web retrieval switched off; the tool then reports
# itself unavailable instead of failing.
TAVILY_API_KEY=tvly-your-key-here
# NFL_WEB_SEARCH_PROVIDER=tavily       # tavily | brave | none
# NFL_WEB_SEARCH_MAX_RESULTS=5
# NFL_WEB_SEARCH_MAX_CALLS_PER_RUN=3   # hard ceiling on paid searches per question
# NFL_WEB_SEARCH_RECENCY_DAYS=         # blank = per-search choice
# NFL_WEB_SEARCH_MAX_CHARS_PER_RESULT=1200
# NFL_WEB_SEARCH_TIMEOUT_SECONDS=15
# NFL_WEB_SEARCH_CACHE_TTL_SECONDS=900
# NFL_WEB_SEARCH_CACHE_MAX_ENTRIES=128
# NFL_WEB_SEARCH_ALLOWED_DOMAINS=      # comma-separated; empty = allow all
# NFL_WEB_SEARCH_BLOCKED_DOMAINS=
# NFL_WEB_SEARCH_DROP_FLAGGED_RESULTS=true

# --- Local RAG (Milestone 4) -----------------------------------------------
# Uses the LLM key above. Building the index costs about $0.0002.
# NFL_EMBEDDING_PROVIDER=openai        # openai | fake
# NFL_EMBEDDING_MODEL=text-embedding-3-small
# NFL_EMBEDDING_DIMENSIONS=            # blank = model default (1536)
# NFL_EMBEDDING_BATCH_SIZE=64
# NFL_KNOWLEDGE_DIR=data/knowledge
# NFL_KNOWLEDGE_INDEX_PATH=data/rag/index.parquet
# NFL_RAG_TOP_K=4
# NFL_RAG_MIN_SCORE=0.45               # calibrated for text-embedding-3-small;
#                                      # recalibrate if you change the model
# NFL_RAG_CHUNK_TOKENS=350
# NFL_RAG_CHUNK_OVERLAP=50
